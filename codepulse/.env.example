# ─────────────────────────────────────────────────────────────────────────────
# CodePulse — environment configuration
# Copy to `.env.local` (never commit .env.local — it is git-ignored).
# EVERY value below is read ONLY on the server (API routes / lib/*). No key is
# ever bundled into client JavaScript.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Database (Supabase PostgreSQL + pgvector) ─────────────────────────────
# When these are absent CodePulse automatically falls back to its embedded
# durable store (./data/codepulse.json) so the demo never dies on stage.
NEXT_PUBLIC_DB_LABEL=Supabase PostgreSQL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # server-side only, NEVER NEXT_PUBLIC_
# optional: point at a dedicated schema
SUPABASE_SCHEMA=public

# ── 2. AI provider (server-side only) ────────────────────────────────────────
# Optional. If absent, CodePulse uses its built-in deterministic
# PulseReasoner engine (still 100% functional, offline, zero-latency).
# Priority: OPENAI > GEMINI > ANTHROPIC > built-in engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── 3. Runtime ───────────────────────────────────────────────────────────────
# Extra dev-server origins allowed to reach /_next assets (comma separated)
ALLOWED_DEV_ORIGINS=
# Telemetry heartbeat cadence for the Captain's Logbook (ms) — default 10 min
NEXT_PUBLIC_TELEMETRY_INTERVAL_MS=600000
